library(SSN2)
library(tidyverse)
# load built function for running a k-fold cross validation on SSN models
source("../scripts/helperfnx/SSNkfoldcv_pbapply.R")
# load built function to add raw coef estimates/SEs to tidy() estimate table
source(file = "../scripts/helperfnx/ssn_backtransformation_fnx.R")
knitr::opts_chunk$set(echo = TRUE)
# Read in the SSN object and prediction sites contained in the "preds10288"
# predictions slot of the SSN object. (< 1 min to load)
ssn_obj <- ssn_import(path = "../ssnobj/MASSN_july_standardized.ssn/",
overwrite = TRUE,
predpts = "preds10288.shp")
# Observation site data updates
obs_df <- ssn_get_data(ssn_obj, "obs") |>
mutate(yearf = factor(yearf),
stn_id = factor(stn_id))
saveRDS(obs_df, "../data/obs_df_MA_SSN.RDS")
ssn_obj <- ssn_put_data(obs_df, ssn_obj, "obs")
# Prediction site data updates
preds_df <- ssn_get_data(ssn_obj, "preds10288") |>
mutate(yearf = factor("0"),
stn_id = factor(stn_id))
saveRDS(preds_df, "../data/preds_df_MA_SSN.RDS")
ssn_obj <- ssn_put_data(preds_df, ssn_obj, "preds10288")
# save flowlines from ssn object if desired
saveRDS(object = ssn_obj$edges, file = "../data/ssnobj_edges.RDS")
fit99 <- ssn_lm(
formula = WT_avg ~ sAreaKm2 + sdJLtavg + sBFIc + sCPY100x + sv2elevm + sNIDDENw,
ssn.object = ssn_obj,
tailup_type = "mariah",
euclid_type = "gravity",
random = ~ stn_id + yearf,
additive = "afvArea",
estmethod = "reml"
)
fit_esttab <- tidy(fit99)
# reload the continuous variables from the obs data to make back transformations
cont_cov_data <- readRDS(file = "../data/continuous_obs_vars.RDS")
# generate the estimate table with raw units coefficients
estimate_table <-
std_to_raw_estimate_table_fnx(cont_cov_data, fit_esttab,
roundval = 8, message = FALSE)
(esttab_cooling_df <- estimate_table |>  mutate(cool1C = -1/raw_est) )
write_csv(esttab_cooling_df, file = "../tables/estimate_table.csv")
# k-fold cross validation for the fitted SSN model to assess predictive performance
k10foldoutput <- SSNkfoldcv(fit99, kfoldn = 10, clustern = 10)
write_csv(x = k10foldoutput, file = "../tables/k10foldcv_table.csv")
# LOOCV for the fitted SSN model for comparison of diagnostic statistics to
# k-fold cross validation
fit99_loocv <- SSN2::loocv(fit99)
write_csv(x = fit99_loocv, file = "../tables/loocv_table.csv")
# Look at the variance decomposition among model structure components
fit99_varcomp <- varcomp(fit99)
write_csv(x = fit99_varcomp, file = "../tables/varcomp_table.csv")
plot(fit99, which = 1)
plot(fit99, which = 2)
plot(fit99, which = 3)
plot(fit99, which = 4)
plot(fit99, which = 5)
plot(fit99, which = 6)
fit99_aug <- augment(fit99)
(fit99_obspres_plot <-
ggplot(data = fit99_aug, aes(x = WT_avg,
size = sNIDDENw*100,
# size = sv2elevm*100,
# size = sAreaKm2*100,
# size = sdJLtavg*100,
# size = sBFIc*100,
# size = sCPY100x,
y = .fitted)) +
geom_abline(yintercept = 0, slope = 1) +
geom_point(alpha = 0.5) +
geom_smooth(method = "lm", formula = y ~ x) +
theme_bw()
)
ggplot() +
geom_sf(data =
filter(fit99_aug, .std.resid < 0 & .std.resid > -4),
# filter(fit99_aug, .std.resid > 0 & .std.resid < 4),
aes(
size = .std.resid*-1
# color = .std.resid
),
# size = 3,
alpha = 0.3) +
# scale_color_viridis_c(limits = c(-4, 4), option = "H") +
theme_bw()
# Compute the Torgegram
tg <- Torgegram(formula = WT_avg ~ sAreaKm2 + sdJLtavg + sBFIc + sCPY100x +
sv2elevm + sNIDDENw,
ssn.object = ssn_obj)
# Plot it
plot(tg)
# make predictions for scenario
augm_rcnt <- augment(x = fit99, newdata = "preds10288")
summary(augm_rcnt$.fitted)
saveRDS(augm_rcnt ,file = "../predictions/augm_rcnt.RDS")
# pull prediction data and make the update with 2C warming field
fit99preds_rcntdam <- ssn_get_data(fit99, name = "preds10288") |>
mutate(sNIDDENw = sdam1)
# put the updated air temp data back into the model object and rename it
fit99_rcntdam <- ssn_put_data(fit99preds_rcntdam, fit99, name = "preds10288")
# run predictions via augment() with the new model data
augm_rcntdam <- augment(x = fit99_rcntdam, newdata = "preds10288")
saveRDS(augm_rcntdam ,file = "../predictions/augm_rcntdam.RDS")
# pull prediction data and make the update with 2C warming field
fit99preds_rcntshade <- ssn_get_data(fit99, name = "preds10288") |>
mutate(sCPY100x = sCPYadd10)
# put the updated air temp data back into the model object and rename it
fit99_rcntshade <- ssn_put_data(fit99preds_rcntshade, fit99, name = "preds10288")
# run predictions via augment() with the new model data
augm_rcntshade <- augment(x = fit99_rcntshade, newdata = "preds10288")
saveRDS(augm_rcntshade ,file = "../predictions/augm_rcntshade.RDS")
# pull prediction data and make the update with 2C warming field
fit99preds_rcntdamshade <- ssn_get_data(fit99, name = "preds10288") |>
mutate(sNIDDENw = sdam1,
sCPY100x = sCPYadd10)
# put the updated air temp data back into the model object and rename it
fit99_rcntdamshade <- ssn_put_data(fit99preds_rcntdamshade, fit99, name = "preds10288")
# run predictions via augment() with the new model data
augm_rcntdamshade <- augment(x = fit99_rcntdamshade, newdata = "preds10288")
saveRDS(augm_rcntdamshade ,file = "../predictions/augm_rcntdamshade.RDS")
# Scenario: Future climate (+2degC air temp) warming                        ####
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# pull prediction data and make the update with 2C warming field
fit99preds_futr <- ssn_get_data(fit99, name = "preds10288") |>
mutate(sdJLtavg = sATJL2C)
# put the updated air temp data back into the model object and rename it
fit99_futr <- ssn_put_data(fit99preds_futr, fit99, name = "preds10288")
# run predictions via augment() with the new model data
augm_futr <- augment(x = fit99_futr, newdata = "preds10288")
saveRDS(augm_futr ,file = "../predictions/augm_futr.RDS")
# pull prediction data and make the update with 2C warming field
fit99preds_futrdam <- ssn_get_data(fit99, name = "preds10288") |>
mutate(sNIDDENw = sdam1,
sdJLtavg = sATJL2C)
# put the updated air temp data back into the model object and rename it
fit99_futrdam <- ssn_put_data(fit99preds_futrdam, fit99, name = "preds10288")
# run predictions via augment() with the new model data
augm_futrdam <- augment(x = fit99_futrdam, newdata = "preds10288")
saveRDS(augm_futrdam ,file = "../predictions/augm_futrdam.RDS")
# pull prediction data and make the update with 2C warming field
fit99preds_futrshade <- ssn_get_data(fit99, name = "preds10288") |>
mutate(sCPY100x = sCPYadd10,
sdJLtavg = sATJL2C)
# put the updated air temp data back into the model object and rename it
fit99_futrshade <- ssn_put_data(fit99preds_futrshade, fit99, name = "preds10288")
# run predictions via augment() with the new model data
augm_futrshade <- augment(x = fit99_futrshade, newdata = "preds10288")
saveRDS(augm_futrshade ,file = "../predictions/augm_futrshade.RDS")
# pull prediction data and make the update with 2C warming field
fit99preds_futrdamshade <- ssn_get_data(fit99, name = "preds10288") |>
mutate(sNIDDENw = sdam1,
sCPY100x = sCPYadd10,
sdJLtavg = sATJL2C)
# put the updated air temp data back into the model object and rename it
fit99_futrdamshade <- ssn_put_data(fit99preds_futrdamshade, fit99, name = "preds10288")
# run predictions via augment() with the new model data
augm_futrdamshade <- augment(x = fit99_futrdamshade, newdata = "preds10288")
saveRDS(augm_futrdamshade ,file = "../predictions/augm_futrdamshade.RDS")
gc()
