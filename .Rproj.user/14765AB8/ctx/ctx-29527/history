# observation and prediction site geospatial data
obs_df <- readRDS("../data/obs_df_MA_SSN.RDS")
# number of unique sites for july data
july_year_count_plot <-
obs_df |>
# july_data00 |>
reframe(.by = stn_id_num, year_n = n()) |>
ggplot(aes(x = year_n)) +
geom_density() +
theme_classic() +
scale_x_continuous(n.breaks = 7) +
labs(x = "Record length for a site (years)",
# title = "Observation sites by record length density",
y = "Site density")
