# Goal of this script is to read in all the data for observation and prediction
# sites, join and transform all variables into individual obs and preds site
# data frames that can be inserted back into the ssn object and saved for model 
# fitting and predictions. This script exports a final ssn object that can be
# imported into later model fitting scripts. This will unify and simplify these
# later scripts with an identical input for analysis.



# library(devtools); install_github("USEPA/SSN2", dependencies=TRUE, force=FALSE)
# remotes::install_github("USEPA/SSN2", ref = "develop")
library(tidyverse)
library(foreign)
library(sf)
library(SSN2)



#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# Functions                                                                ####
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# standardize variable function
source(file = "./scripts/helperfnx/ssn_standardize_variables_function.R")

# Standardize a prediction data set based on the observed data set function
source(file = "./scripts/helperfnx/ssn_standardize_prediction_variables_function.R")
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~####



#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# read in SSN Object and distance matrices(.ssn)                           ####
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# Read in the SSN object and prediction sites contained in the "preds10288" 
# predictions slot of the SSN object. (< 1 min to load)
ssn_obj <- ssn_import(path = paste0(getwd(),"/ssnobj/lsn_july.ssn"), 
                      overwrite = TRUE, 
                      predpts = "preds10288.shp")

# Create the network-wise distance matrix between all observation and 
# prediction sites. (< 1 min) 
# ssn_create_distmat(ssn_obj, predpts = "preds10288", overwrite = TRUE)
