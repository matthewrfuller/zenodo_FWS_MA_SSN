#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
#                    OBSERVATION DATA                                      ####
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~


#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
#  OBSERVATION SITE DATA                                                   ####
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# Below contains the mean monthly temp data that can be joined to the
# observation site (obs) data in the ssn object along with the covariate data.


# *** TIP *** ALWAYS JOIN TO THIS DATA FOR OBS VIA EITHER SSNID OR COMID

july_data00 <- read_csv(file = "./data/obs_sc_july_avg_df.csv") |>
  left_join(read_csv(file = "./data/daymet_obs.csv"), 
            by = c("ssnid","smpl_year") )  |>
  left_join(xgb_data, by = "COMID") |>
  left_join(nhdv2_slopeelev, by = "COMID") |>
  rename(WT_min = avg_min_WT, WT_avg = avg_mean_WT, WT_max = avg_max_WT) |>
  select(-ends_with("_AT"))
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~####



#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# PREDICTION SITE DATA                                                     ####
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

# import daymet data for prediction sites [JOIN BY SSNID]
daymetpreds07 <- read_csv(file = "./data/daymet_preds.csv") %>% 
  filter(smpl_year != 1994)  %>% 
  reframe(.by = ssnid,
          dJLprcp = mean(d07_prcp), # mean values covering full data range
          dJLtavg = mean(d07_tavg), # mean values covering full data range
          dJLtmin = mean(d07_tmin), # mean values covering full data range
          dJLtmax = mean(d07_tmax), # mean values covering full data range
          dJL7ddm = mean(d07_7ddm), # mean values covering full data range
          dJL1ddm = mean(d07_1ddm)) # mean values covering full data range 



# join XGBoost to StreamCat data by COMID
preds_cov_data <-  
  left_join(xgb_data, streamcat_df, by = "COMID") |>
  right_join(preds_comidssnid_key, by = "COMID") |>
  left_join(daymetpreds07, by = "ssnid") |>
  left_join(nhdv2_slopeelev, by = "COMID")

# identifies if there are any infinite or NA values in the data frame
names(preds_cov_data)[apply(preds_cov_data, 2, 
                            function(x) any(is.na(x) | is.infinite(x)))]
# should be "character(0)" if the data have zero NAs, Inf, or -Inf values
