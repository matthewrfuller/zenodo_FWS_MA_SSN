#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# Standardize observation covariate data                                   ####
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# Extract observation site data frame from SSN object and join to temperature data for the month.  
ssn_obs_df00 <- ssn_get_data(ssn_obj, name = "obs") %>%
  select(everything(),-station_id, -smpl_year, -contains(c("avg_","sum_","NEAR_", "itude")),
         AreaKm2 = TotAreaKm2) %>%
  left_join(july_data00, by = "ssnid") %>%
  mutate(yearf = as.factor(smpl_year), 
         stn_id = as.factor(stn_id_num)) %>%
  rename(dJLtavg = d07_tavg, dJLtmin = d07_tmin, dJLtmax = d07_tmax, 
         dJLprcp = d07_prcp, dJL7ddm = d07_7ddm, dJL1ddm = d07_1ddm) %>%
  mutate(ATJL0C = dJLtavg,
         ATJL2C = dJLtavg,     # THESE LEFT AS ORIGINAL AIR TEMP SO PREDICTION
         ATJL4C = dJLtavg,     # STANDARDIZATION IS BASED ON BASE-LEVEL (+0 degC)
         ATJL6C = dJLtavg,     # AIR TEMPERATURE MEAN AND STANDARD DEVIATIONS
         ATJL8C = dJLtavg) %>% # AND NOT THE ADJUSTED (+# degC) TEMPS
  mutate(CPYadd05 = CPY100x,  # THESE LEFT AS ORIGINAL CANOPY COVER IN THE OBS
         CPYadd10 = CPY100x,  # DATA SO THAT THE STANDARDIZATIONS CAN BE MADE 
         CPYadd15 = CPY100x,  # RELATIVE TO THE ORIGINAL DATA MEAN AND SD 
         CPYadd20 = CPY100x,  # RATHER THAN THE MODIFIED VALUES
         CPYadd25 = CPY100x,
         CPYadd30 = CPY100x,
         CPYadd35 = CPY100x,
         CPYadd40 = CPY100x,
         CPYadd45 = CPY100x,
         CPYadd50 = CPY100x,
         CPYmax = CPY100x) %>%
  mutate(dam1 = NIDDENw,
         dam2 = NIDDENw,
         dam3 = NIDDENw, 
         dam4 = NIDDENw,
         dam5 = NIDDENw)

ssn_obs_df01 <- ssn_obs_df00  %>% st_drop_geometry()  

# identifies if there are any infinite or NA values in the data frame
# names(ssn_obs_df01)[apply(ssn_obs_df01, 2, function(x) any(is.na(x) | is.infinite(x)))]
# should be "character(0)" if the data have zero NAs, Inf, or -Inf values




# Standardize the continuous variables used in the model fit so their estimated coefficients can be compared directly.  

# select the continuous variable names from the covariate data frame
continuous_var_names <- 
  names(select(ssn_obs_df01, where(is.numeric), 
               -ssnid, -smpl_year, -contains("WT_"), -starts_with("NEAR_"), 
               -stn_id_num, -stn_id, -COMID
  ) )

# extract the continuous data columns
cont_cov_data <- dplyr::select(ssn_obs_df01, all_of(continuous_var_names))  
saveRDS(object = cont_cov_data, file = "./data/continuous_obs_vars.RDS")

# apply the "stand()" function across all columns to standardize each covariate
cont_cov_data_stdzd <- apply(cont_cov_data,2,stand)

# add prefix ("s") to standardized column names
colnames(cont_cov_data_stdzd) <- paste0("s", continuous_var_names)

# join standardized data to original data frame
ssn_obs_df01_stdzd <- bind_cols(ssn_obs_df00, cont_cov_data_stdzd)
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~####

data.frame(fld_name = names(ssn_obs_df01_stdzd)) |> 
  mutate(nchar = nchar(fld_name)) |> filter(nchar >8)



#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# split observation data into training and validation data                 ####
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# A set of observed station data is set aside from the model fitting process to be used as a validation test data set after a model has been selected. We do this by setting the validation data temperature measurements equal to NA in the ssn object so that they are not included in the model fitting process.

#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~####



#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# Reinsert observation data back into SSN object for model fitting         ####
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
ssn_obj_stdzd <- ssn_put_data(ssn_obs_df01_stdzd, ssn_obj, "obs")
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~####






#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
#                    PREDICTION DATA                                       ####
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# extract the prediction site data from the ssn object
ssn_preds_df00 <- ssn_get_data(x = ssn_obj_stdzd, name = "preds10288") %>%
  left_join(select(preds_cov_data, -COMID), by = "ssnid") %>%
  mutate(stn_id = as.factor(pid),
         yearf = factor(2016))  %>%
  rename(AreaKm2 = TotAreaKm2)  %>%
  mutate(ATJL0C = dJLtavg,
         ATJL2C = dJLtavg+2,
         ATJL4C = dJLtavg+4,
         ATJL6C = dJLtavg+6,
         ATJL8C = dJLtavg+8) %>%
  mutate(CPYadd05 = if_else(CPY100x + 5 > 100, 100, CPY100x + 5),
         CPYadd10 = if_else(CPY100x + 10 > 100, 100, CPY100x + 10),
         CPYadd15 = if_else(CPY100x + 15 > 100, 100, CPY100x + 15),
         CPYadd20 = if_else(CPY100x + 20 > 100, 100, CPY100x + 20),
         CPYadd25 = if_else(CPY100x + 25 > 100, 100, CPY100x + 25),
         CPYadd30 = if_else(CPY100x + 30 > 100, 100, CPY100x + 30),
         CPYadd35 = if_else(CPY100x + 35 > 100, 100, CPY100x + 35),
         CPYadd40 = if_else(CPY100x + 40 > 100, 100, CPY100x + 40),
         CPYadd45 = if_else(CPY100x + 45 > 100, 100, CPY100x + 45),
         CPYadd50 = if_else(CPY100x + 50 > 100, 100, CPY100x + 50),
         CPYmax = 100)  %>%
  mutate(dam1 = if_else(NIDDENw - 0.1 < 0, 0, NIDDENw - 0.1),
         dam2 = if_else(NIDDENw - 0.2 < 0, 0, NIDDENw - 0.2),
         dam3 = if_else(NIDDENw - 0.3 < 0, 0, NIDDENw - 0.3), 
         dam4 = if_else(NIDDENw - 0.4 < 0, 0, NIDDENw - 0.4),
         dam5 = if_else(NIDDENw - 0.5 < 0, 0, NIDDENw - 0.5))

ssn_preds_df01 <- ssn_preds_df00 %>% st_drop_geometry() 

# ssn_preds_df00$ssnid[is.na(ssn_preds_df00$NANMSTw)]
# identifies if there are any infinite or NA values in the data frame
names(ssn_preds_df01)[apply(ssn_preds_df01, 2, 
                            function(x) any(is.na(x) | is.infinite(x)))]
# should be "character(0)" if the data have zero NAs, Inf, or -Inf values

# preds_na_comid_df <- 
#   data.frame(COMIDNA = sort(ssn_preds_df01$COMID[is.na(ssn_preds_df01$TOT_BFI)]) )
# write.dbf(preds_na_comid_df, file = "./data/preds_na_comid.dbf")



# extract the continuous data columns
cont_cov_data_preds <- dplyr::select(ssn_preds_df01, all_of(continuous_var_names))

# use the "stdpreds()" function to standardize each prediction covariate
# based on the observation data for each covariate in the fitted model
cont_cov_data_preds_stdzd <- stdpreds(cont_cov_data_preds, cont_cov_data)



# add prefix ("s_") to standardized column names
colnames(cont_cov_data_preds_stdzd) <- paste0("s", continuous_var_names)

# join standardized data to original data frame
ssn_preds_df01_stdzd <- bind_cols(ssn_preds_df00,cont_cov_data_preds_stdzd)  

# field name length checks. need to be <9 for writing to new ssn object (.ssn)
data.frame(fld_name = names(ssn_preds_df01_stdzd)) |> 
  mutate(nchar = nchar(fld_name)) |> filter(nchar >8)

# put the data frame with standardized columns back into the ssn object
ssn_obj_op_stdzd <-
  ssn_put_data(ssn_preds_df01_stdzd, ssn_obj_stdzd, name = "preds10288")  

# write out the prediction site covariate input data
write_csv(ssn_preds_df01_stdzd, file =  "./tables/input_data_preds.csv" )
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~####



#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# Export ssn object with all standardized data                             ####
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
ssn_write(ssn = ssn_obj_op_stdzd, 
          path = "./ssnobj/MASSN_july_standardized.ssn",
          overwrite = TRUE, copy_dist = TRUE)
