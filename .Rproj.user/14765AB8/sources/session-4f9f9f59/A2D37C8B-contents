#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
#                    Read in data                                          ####
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# import field name key to shorten names written to dbf/shp files in SSN object
field_name_key <- read_csv("./data/field_names_key.csv")


# read in key to crosswalk COMID and prediction site ssnid 
preds_comidssnid_key <- read_csv("data/preds_comid_ssnid_key.csv")


# xgboost data for MA [JOIN BY COMID]
xgb_data <- read_csv(file = "./data/mastath-flowlines.csv") %>%
  select(-BASIN_ID, -BASIN, -HUC8, -starts_with(c("TEMP_","TAIR_SUM")))
# reduces name length for ssn object export (.dbf chr limits <= 10)
data.table::setnames(xgb_data, 
                     field_name_key$name_lg, field_name_key$name_sh, 
                     skip_absent = TRUE)

# read in StreamCat data for prediction sites [JOIN BY COMID]
streamcat_df <- read_csv("./data/streamcat_forssn.csv")


# NHDPlusV2 slope and elevation data
nhdv2_slopeelev <- bind_rows(read.dbf(file = "data/NHDV2NE_ELEVSLOPE.dbf"),
                             read.dbf(file = "data/NHDV2MA_ELEVSLOPE.dbf")) |>
  rowwise() |>
  mutate(v2elevm = mean(MAXELEVSMO,MINELEVSMO)/100 ) |> ungroup() |>
  select(COMID, v2elevm, v2slope = SLOPE)
           


