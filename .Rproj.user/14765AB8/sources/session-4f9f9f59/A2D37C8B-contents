# Explore correlations among covariates to detect multicollinearity issues
cov_corr_mtx <- cont_cov_data  %>% 
  drop_na() %>%
  cor()


corpplot <- {
  corrplot::corrplot.mixed(corr = cov_corr_mtx, 
                           lower = "number", upper = "ellipse", diag = c("n"),
                           tl.pos = c("lt"), tl.cex = 0.75, tl.col = 1, 
                           title = "XGBoost Covariate Correlations",
                           mar = c(0,0,3,0),
                           number.digits = 1, number.cex = 0.4,
                           lower.col = rev(corrplot::COL2('RdBu', 200)),
                           upper.col = rev(corrplot::COL2('RdBu', 200)),
                           cl.cex = 0.5, cl.align.text = "r")
  
  recordPlot()
}

ggsave(filename = "./figures/XGBoost_corrplot.png", 
       plot = replayPlot(corpplot), 
       width = 11, height = 11, units = "in", bg = NA, dpi = 300)


