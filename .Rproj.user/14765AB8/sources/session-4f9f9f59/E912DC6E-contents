# Set up the global environment  

Load necessary libraries for analysis.  

```{r setup, include=FALSE}
library(tidyverse)
library(magrittr)
library(SSN)
library(foreign)
library(padr)
library(zoo)
library(pander)

knitr::opts_chunk$set(echo = TRUE)
```

# Functions for SSN model evaluations  

Source personal functions written to help with SSN model selection and evaluations.  


```{r functions sourcing}
# Function to standardize variables
source(file = "../scripts/helperfnx/ssn_standardize_variables_function.R")

# Function to standardize a prediction data set based on the fitting data set
source(file = "../scripts/helperfnx/ssn_standardize_prediction_variables_function.R")

# Get raw and standardized fixed effects and SEs from glmssn
source(file = "../scripts/helperfnx/ssn_extract_model_covariate_estimate_table_from_fitted_glmssn_function.R")

# get a subset of the results from the SSN InfoCritCompare() SSN package func
source(file = "../scripts/helperfnx/ssn_subset_of_InfoCritCompare_results_function.R")

# Full Diagnostics results gathered from fitted a glmssn 
source(file = "../scripts/helperfnx/ssn_diagnostic_statistics_function.R")

# partial diagnostics results gathered from a fitted glmssn
source(file = "../scripts/helperfnx/ssn_diag_fnx.R")

# backtransformation function for generating estimate table
source(file = "../scripts/helperfnx/ssn_backtransformation_fnx.R")

# formula combination functions
source(file = "../scripts/helperfnx/ssn_formula_all_combo_function.R")
```


# Read in data  

## SSN Object (.ssn)  

Read in the SSN object and prediction sites contained in the "preds" predictions slot of the SSN object.  


```{r import ssn obj, cache=TRUE}
# ~2 min to load
ssn_obj <- importSSN("../ssnobj/lsn_july.ssn", predpts = "preds10288")  
```

Create the network-wise distance matrix between all observation and prediction sites.  

```{r create distance matrix, cache=TRUE}
createDistMat(ssn_obj, predpts = "preds10288", o.write=T)  # < 1 min
```


Plot the ssn object network and observation points.  

```{r plot ssn object network and observation sites}
ssn_obj_plot <- {
  plot(ssn_obj, lwdLineCol="afvArea", lwdLineEx=5,lineCol="dodgerblue",
     pch=16, xlab="x-coordinate (m)", ylab="y-coordinate (m)", asp=1,
     main = "Massachusetts network and observation sites")
  
  recordPlot()
}

ggsave(filename = "../figures/SSN_network_obs_sites_map.png",
       width = 6.5, height = 4.5, units = "in", dpi = 300)
```


