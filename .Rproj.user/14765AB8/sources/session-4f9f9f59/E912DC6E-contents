### Fit aspatial model  

Fit an aspatial model.  

```{r fit_general_aspatial_model}
# Extract dataframe and fit basic aspatial model with un-standardized predictors
ssn_obj_lm <-
  lm(avg_mean_W ~ 
       s_TOT_CNPY11_BUFF100 +
       s_TOT_ELEV_MEAN +
       # s_TOT_STREAM_SLOPE +
       s_TOT_BASIN_SLOPE +
       s_TOT_BFI +
       s_TotAreaKm2 +
       
       s_TOT_NLCD11_WATER +
       
       s_TOT_NID_STORAGE2013 +
       # s_TOT_NDAMS2013 + 
       # s_TOT_NORM_STORAGE2013 +
       # s_TOT_MAJOR2013 +
       
       s_TOT_STREAM_LENGTH +
       s_TOT_TAV7100_JUL, 
     data=ssn_obs_df01_stdzd)

summary(ssn_obj_lm)

plot(ssn_obj_lm)

# VIF values ordered largest to smallest. Values greater than 2 are problematic
(vif_values <- 
    car::vif(ssn_obj_lm) %>%
  data.frame()  %>% rownames_to_column() %>% 
  rename(FixedEffect = "rowname", vif = ".") %>%
  arrange(desc(vif))
)
```

## Standardize prediction data  



##  4.2  Prediction sites  

```{r read in and preprocess prediction data}
# extract the prediction site data from the ssn object
ssn_preds_df01 <- getSSNdata.frame(x = ssn_obj_stdzd, Name = "preds10288") %>%
  left_join(., cov_data00, by = c("COMID" = "COMID")) %>%
  arrange(pid) %>%
  column_to_rownames(var = "pid") %>%
  rownames_to_column(var = "pid") %>%
  mutate(stn_id_num = as.factor(pid))  %>%
  mutate(TOT_TAV7_0C_JUL = TOT_TAV7100_JUL,
         TOT_TAV7_2C_JUL = TOT_TAV7100_JUL+2,
         TOT_TAV7_4C_JUL = TOT_TAV7100_JUL+4,
         TOT_TAV7_6C_JUL = TOT_TAV7100_JUL+6,
         TOT_TAV7_8C_JUL = TOT_TAV7100_JUL+8)


# identifies if there are any infinite or NA values in the data frame
names(ssn_preds_df01)[apply(ssn_preds_df01, 2, 
                            function(x) any(is.na(x) | is.infinite(x)))]
# should be "character(0)" if the data have zero NAs, Inf, or -Inf values

# preds_na_comid_df <- 
#   data.frame(COMIDNA = sort(ssn_preds_df01$COMID[is.na(ssn_preds_df01$TOT_BFI)]) )
# write.dbf(preds_na_comid_df, file = "../data/preds_na_comid.dbf")
```


```{r standardize the predictions}
# extract the continuous data columns
cont_cov_data_preds <- 
  dplyr::select(ssn_preds_df01, 
                all_of(continuous_var_names))

# use the "stdpreds()" function to standardize each prediction covariate
# based on the observation data for each covariate in the fitted model
cont_cov_data_preds_stdzd <- stdpreds(cont_cov_data_preds, cont_cov_data)


# add prefix ("s_") to standardized column names
colnames(cont_cov_data_preds_stdzd) <- paste0("s_", continuous_var_names)

# join standardized data to original data frame
ssn_preds_df01_stdzd <- bind_cols(ssn_preds_df01,cont_cov_data_preds_stdzd) %>%
  mutate(pidsave = pid,
         yearf = factor(2016)) %>%
  column_to_rownames(var = "pid")  %>%
  rename(pid = "pidsave") %>%
  relocate(pid, .after = rid) 

# identifies if there are any infinite or NA values in the data frame
names(ssn_preds_df01_stdzd)[apply(ssn_preds_df01_stdzd, 2, 
                            function(x) any(is.na(x) | is.infinite(x)))]
# should be "character(0)" if the data have zero NAs, Inf, or -Inf values

ssn_preds_df01_stdzd$pid[is.na(ssn_preds_df01_stdzd$TOT_BFI)]
ssn_preds_df01_stdzd$COMID[is.na(ssn_preds_df01_stdzd$TOT_BFI)]

# put the data frame with standardized columns back into the ssn object
ssn_obj_op_stdzd <-
  putSSNdata.frame(ssn_preds_df01_stdzd, ssn_obj_stdzd, Name = "preds10288")  
```


```{r}
# write out the observation site covariate input data
write_csv(ssn_obs_df01_stdzd, file =  "../tables/input_data_obs.csv" )

# write out the observation and prediction site covariate input data
write_csv(ssn_preds_df01_stdzd, file =  "../tables/input_data_preds.csv" )
```


# Fit SSN models   

## Fit competing model structures  


```{r fit00 ssn model, cache=TRUE}
(fit00_start <- Sys.time())
ssn_fit00 <- 
  SSN::glmssn(avg_mean_W ~ 
                s_TOT_CNPY11_BUFF100 +
                s_TOT_ELEV_MEAN +
                s_TOT_STREAM_SLOPE +
                # s_TOT_BASIN_SLOPE + 
                s_TOT_BFI +
                s_TotAreaKm2 +
                
                s_TOT_NLCD11_WATER +
                
                # s_TOT_NID_STORAGE2013 +
                s_TOT_NDAMS2013 + 
                # s_TOT_NORM_STORAGE2013 +
                # s_TOT_MAJOR2013 +
                
                # s_TOT_STREAM_LENGTH +
                s_TOT_TAV7100_JUL, 
              
              ssn.object = ssn_obj_op_stdzd,
              EstMeth= "ML", family="gaussian", 
              addfunccol = "afvArea",
              CorModels=c("stn_id_num", "yearf",
                          "Exponential.tailup",
                          "Exponential.taildown",
                          "Exponential.Euclid"))
(fit00_end <- Sys.time()); (fit00_time <- fit00_end - fit00_start)


(var_comp_out00 <- varcomp(ssn_fit00) %>% 
   mutate(Proportion = round(Proportion, 2) ) )

(test_diagnostics00 <- diag_fnx(ssn_fit00) )

(fit00_esttab <- estimate_table_from_glmssn_obj(ssn_fit00, cont_cov_data,5)  %>%
  arrange(desc(abs(Std_Est))) )

loocv_fit00 <- residuals.glmssn(ssn_fit00, cross.validation = TRUE)

summary(ssn_fit00)
```


