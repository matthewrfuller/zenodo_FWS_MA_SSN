# Initial testing of the "SSNbler" R package for SSN object development
# 
library(tidyverse)
library(sf)
library(leaflet)
# remotes::install_github("pet221/SSNbler", ref = "main")
library(SSN2)
library(SSNbler)


# tutorial/vignette for SSNbler:
# https://pet221.github.io/SSNbler/articles/introduction.html

# vignette(package = "SSNbler")

# Read in the edges, obs, and preds data
MA_streams <- st_read("./data/MA_SSN/edges.shp") |>
  select(COMID, LENGTHKM, TotDASqKM, rcaAreaKm2, TotAreaKm2)
MA_obs <- st_read("./data/MA_SSN/sites.shp") |>
  select(-starts_with("NEAR_"),-rid, -ratio, -upDist, -afvArea, -locID, - netID, -pid)
MA_preds <- st_read("./data/MA_SSN/preds10288.shp") |>
  select(-starts_with("NEAR_"),-rid, -ratio, -upDist, -afvArea, -locID, - netID, -pid)

# view the data
ggplot() +
  geom_sf(data = MA_streams) +
  geom_sf(data = MA_preds, color = "red", size = 1) +
  geom_sf(data = MA_obs, color = "green", size = 2) 

# create LSN (1 min for MA SSN with 16k reaches)
edges <- lines_to_lsn(streams = MA_streams,
                      lsn_path = "./MA_SSN_LAN",
                      check_topology = TRUE,
                      snap_tolerance = 1,
                      topo_tolerance = 10,
                      overwrite = TRUE )

