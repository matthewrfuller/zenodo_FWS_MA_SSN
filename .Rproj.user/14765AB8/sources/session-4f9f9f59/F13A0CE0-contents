nodes <- st_read("./MA_SSN_LAN/nodes.gpkg")

node_errors <- st_read("./MA_SSN_LAN/node_errors.gpkg") |> st_transform(4326) |>
  modify_if(is.character, as.factor)
summary(node_errors)

ggplot() + 
  geom_sf(data = edges) +
  geom_sf(data = filter(nodes, nodecat == "Outlet"))

# Set up basemap tiles for various background maps
basemap <- leaflet() |>
  # add background maps
  addProviderTiles("Esri.WorldTopoMap", group = "Esri.WorldTopoMap") |>
  addProviderTiles("Esri.WorldImagery", group = "Esri.WorldImagery") |>  
  # add a layers control
  addLayersControl(baseGroups = c("Esri.WorldTopoMap",
                                  "Esri.WorldImagery"),
                   # position background map selection icon in the top-left part of map
                   position = "topleft")


# Map the plots for each sector.  
(node_check_leaflet <- basemap |>
    addPolylines(data = st_transform(edges, 4326), color = "blue", weight = 1) |>
    # addCircleMarkers(data = filter(st_transform(nodes, 4326), nodecat == "Outlet"),
    #                  radius = 4, opacity = 1, color = "green" ) |>
    addCircleMarkers(data = filter(node_errors, error == "Downstream Divergence"),
                     popup = ~paste0("PointID: ", pointid, "<br>","error: ", error),
                     radius = 1, opacity = 1, color = "red" ) 
)


