## Standardize observation covariate data  


# Extract observation site data frame from SSN object and join to temperature data for the month.  
ssn_obs_df00 <- ssn_get_data(ssn_obj, name = "obs") %>%
  left_join(x = .,
            select(july_data00, ssnid, stn_id_num, COMID),
            by = "ssnid") %>%
  mutate(yearf = as.factor(smpl_year),
         stn_id_num = as.factor(stn_id_num)) %>%
  rename(AreaKm2 = TotAreaKm2)  %>%  
  left_join(., cov_data00, by = c("COMID"))  %>% distinct()
  left_join(y=daymetobs07, by = c("ssnid", "smpl_year")) %>%
  mutate(AIR07_0C = AIR07100,
         AIR07_2C = AIR07100, # THESE LEFT AS ORIGINAL AIR TEMP SO PREDICTION
         AIR07_4C = AIR07100, # STANDARDIZATION IS BASED ON BASE-LEVEL (+0 degC)
         AIR07_6C = AIR07100, # AIR TEMPERATURE MEAN AND STANDARD DEVIATIONS
         AIR07_8C = AIR07100) # AND NOT THE ADJUSTED (+# degC) TEMPS




test <- ssn_obs_df00 |>
  select(ssnid, smpl_year) #%>% distinct()

ssn_obs_df00[ssn_obs_df00$ssnid == 10106, ]

ssn_obs_df01 <- ssn_obs_df00  %>% st_drop_geometry()  

# identifies if there are any infinite or NA values in the data frame
# names(ssn_obs_df01)[apply(ssn_obs_df01, 2, function(x) any(is.na(x) | is.infinite(x)))]
# should be "character(0)" if the data have zero NAs, Inf, or -Inf values


# Standardize the continuous variables used in the model fit so their estimated coefficients can be compared directly.  


# select the continuous variable names from the covariate data frame
continuous_var_names <- 
  names(select(ssn_obs_df01, where(is.numeric), AIRTC = avg_mean_A,
               -avg_mean_W, -avg_min_AT, -avg_max_AT,
               -ssnid, -smpl_year, -contains("_WT"), -sum_precip, -latitude,
               -longitude, -starts_with("NEAR_"), -upDist, -afvArea, -locID, 
               -netID, -pid, -stn_id_num, -COMID, -rid, -ratio
               ) )

# extract the continuous data columns
cont_cov_data <- 
  dplyr::select(ssn_obs_df01, all_of(continuous_var_names))  

# apply the "stand()" function across all columns to standardize each covariate
cont_cov_data_stdzd <- apply(cont_cov_data,2,stand)

# add prefix ("s_") to standardized column names
colnames(cont_cov_data_stdzd) <- paste0("s", continuous_var_names)

# join standardized data to original data frame
ssn_obs_df01_stdzd <- bind_cols(ssn_obs_df00, cont_cov_data_stdzd)



# A set of observed station data is set aside from the model fitting process to be used as a validation test data set after a model has been selected. We do this by setting the validation data temperature measurements equal to NA in the ssn object so that they are not included in the model fitting process.




# put the data frame with standardized columns back into the ssn object
ssn_obj_stdzd <- ssn_put_data(ssn_obs_df01_stdzd, ssn_obj, "obs")



### Plot temp vs drainage area  


# plot watershed area vs temperature
ggplot() +
  geom_point(data = ssn_obs_df01_stdzd,
             aes(x = AreaKm2, y = avg_mean_W)) +
  theme_bw() +
  scale_x_log10() +
  labs(x = "Watershed Area (km²)", 
       y = "Water temperature (°C)",
       title = "Observation site watershed area by water temperature")


### Fit aspatial model  

# Fit an aspatial model.  

# Extract dataframe and fit basic aspatial model with un-standardized predictors
ssn_obj_lm <-
  lm(avg_mean_W ~ 
       sCNPY100 +
       sELEV_MEAN +
       # sSTM_SLOPE +
       sBSN_SLOPE +
       sBFI +
       sAreaKm2 +
       
       sH2O +
       
       sNIDSTRG13 +
       # sNDAMS13 + 
       # sNDSTRG13 +
       # sMAJOR13 +
       
       sSTM_LGTH +
       sAIR07100, 
     data=ssn_obs_df01_stdzd)

summary(ssn_obj_lm)

# plot(ssn_obj_lm)

# VIF values ordered largest to smallest. Values greater than 2 are problematic
(vif_values <- 
    car::vif(ssn_obj_lm) %>%
    data.frame()  %>% rownames_to_column() %>% 
    rename(FixedEffect = "rowname", vif = ".") %>%
    arrange(desc(vif))
)





