```



```{r plot July data, fig.width=6.5, fig.height=4.5}
obs_july_ggplot_df <- obs_july_avg_df %>%
  pivot_longer(cols = starts_with("avg"),
               values_to = "TempC",
               names_prefix = "avg_", 
               names_to = c("Statistic","AirWater"), 
               names_sep = "_") %>%
  mutate(Statistic = factor(Statistic, levels = c("min","mean","max")))

facet_labs <- c(min = "Minimum", mean = "Mean",max = "Maximum")

(july_ggplot <- obs_july_ggplot_df %>%
  ggplot(aes(x = smpl_year, 
             color = AirWater, 
             shape = AirWater, 
             y = TempC)) +
    geom_point() +
    theme_bw() +
    scale_color_manual(values = c("red","blue"),
                       labels = c("Air","Water")) +
    scale_shape_manual(values = c(0,19),
                       labels = c("Air","Water")) +
    labs(x = "Year", y = "Temperature (°C)",
         title = "July temperature statistics for MA sites",
         subtitle = paste0("Site location total = ",
                           length(unique(obs_july_ggplot_df$station_id)), "; ",
                           "Site-Year combination total = ", 
                           nrow(obs_july_avg_df) ) ) +
    guides(color = guide_legend(title = "Measurement", title.position = "top"), 
           shape = guide_legend(title = "Measurement", title.position = "top")) +
    theme(legend.position = c(0.1,0.9),
          legend.direction = "horizontal", 
          legend.title.align = 0.5,
          legend.background = element_blank(),
          legend.key = element_blank()) +
    facet_wrap(~Statistic, labeller = labeller(Statistic = facet_labs)) 
    
)
```


